{
  "$schema": "../../../schemas/nx-project.schema.json",
  "name": "story-mode",
  "sourceRoot": "apps/services/story-mode/src",
  "projectType": "library",
  "tags": ["scope:story-mode", "type:worker"],
  "targets": {
    "type-check": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p tsconfig.json", "cwd": "{projectRoot}" }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": { "jestConfig": "apps/services/story-mode/jest.config.mjs", "passWithNoTests": true }
    }
  }
}
