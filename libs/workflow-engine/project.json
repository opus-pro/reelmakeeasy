{
  "$schema": "../../schemas/nx-project.schema.json",
  "name": "workflow-engine",
  "sourceRoot": "libs/workflow-engine/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:library"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "tsc -p {projectRoot}/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/workflow-engine"],
      "options": {
        "jestConfig": "libs/workflow-engine/jest.config.mjs",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
